#!/bin/bash

# Function to display the main help message
show_main_help() {
  echo "Usage: $0 <module> [options]"
  echo
  echo "Available commands:"
  echo "  Initialize    - Gather the input and organize the working directory to run this toolkit."
  echo "  QuickGenePrediction    - Performs a quick gene prediction with metaeuk."
  echo "  SyntenyClustering    - Perform the clustering of elements based on collinear regions."
  echo "  BrakerGenePrediction    - Performs gene prediciton with BRAKER."
  echo "  RobustGenePrediction    - Filter the BRAKER gene prediction, Performs a metaeuk captain prediction, and merge both results."
  echo "  TEPrediction    - Identify putative TEs in elements with EarlGrey approach and Mycomobilome database."
  echo "  CaptainIdentification    - Performs the identification and phylogenetic analysis of Captains of the elements."
  echo "  ClusterCharacterization    - Analyzed and visualized each cluster that had a captain phylogenetic tree."
  echo
  echo "Use '$0 <command> -help' for help on a specific command."
}

# --- Rest of the script ---
MODULE="$1"
shift

# Check if no arguments were provided or if --help was requested
if [ -z "$MODULE" ] || [ "$MODULE" == "-help" ]; then
  show_main_help
  exit 0
fi

# Define the directory where your module scripts are located
MODULES_DIR="$( dirname -- "$( readlink -f -- "$0"; )"; )""/../main/"
MODULE_SCRIPT="$MODULES_DIR/$MODULE.sh"

# Check if the module script exists and is executable
if [ ! -x "$MODULE_SCRIPT" ]; then
  echo "Error: Unknown module '$MODULE'."
  show_main_help
  exit 1
fi

# Execute the module script
exec "$MODULE_SCRIPT" "$@"
