#!/usr/bin/env bash

# Function to display the main help message
show_main_help() {
  echo "Usage: $0 <COMMAND> [options]"
  echo
  echo "Available commands:"
  echo "  Initialize    - Gather the input and organize the working directory to run this toolkit."
  echo "  SyntenyClustering    - Perform the clustering of elements based on collinear regions."
  echo "  OrthogroupsOverrepresentation    - Identify Orthogroups that are overrepresented in the dataset."
  echo "  TEPrediction    - Identify putative TEs in elements with EarlGrey approach and Mycomobilome database."
  echo "  CaptainIdentification    - Performs the identification and phylogenetic analysis of Captains of the elements."
  echo "  ClusterCharacterization    - Analyzed and visualized each cluster that had a captain phylogenetic tree."
  echo "  OrthogroupsAnnotation    - Performs functional annotation of orthogroups."
  echo
  echo "Use '$0 <command> -help' for help on a specific command."
}

COMMAND="$1"
shift

# Check if no arguments were provided or if --help was requested
if [ -z "$COMMAND" ] || [ "$COMMAND" == "-help" ]; then
  show_main_help
  exit 0
fi

# Define the directory where your command scripts are located
COMMANDS_DIR="$( dirname -- "$( readlink -f -- "$0"; )"; )""/../main/"
COMMAND_SCRIPT="$COMMANDS_DIR/$COMMAND.sh"

# Check if the command script exists and is executable
if [ ! -x "$COMMAND_SCRIPT" ]; then
  echo "Error: Unknown command '$COMMAND'."
  show_main_help
  exit 1
fi

# Define the directory where the function libraries are located
LIB_DIR="$( dirname -- "$( readlink -f -- "$0"; )"; )""/../lib/"

# Check that the libraries are there
if [[ ! -d "$LIB_DIR" ]]; then
    echo "Error: folder '$LIB_DIR' does not exist."
    exit 1
else
    if [[ ! -f "${LIB_DIR}/Check.sh" ]]; then
        echo "Error: file '${LIB_DIR}/Check.sh' does not exist."
        exit 1
    fi

    if [[ ! -f "${LIB_DIR}/Utils.sh" ]]; then
        echo "Error: file '${LIB_DIR}/Utils.sh' does not exist."
        exit 1
    fi
fi

# Execute the command script
exec "$COMMAND_SCRIPT" "$@"
