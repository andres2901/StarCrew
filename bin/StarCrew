#!/usr/bin/env bash
# ==============================================================================
# NAME:          Main.sh
# DESCRIPTION:   Main entry point. Validates the environment and dispatches
#                the requested command to its corresponding script.
# USAGE:         ./Main.sh <COMMAND> [options]
#                ./Main.sh -help
#                ./Main.sh -version
# AUTHOR:        Andres F. Lizcano Salas
# DATE:          11/Mar/2026
# VERSION:       1.0.0
# ==============================================================================

set -uo pipefail

# ==============================================================================
# CONSTANTS
# ==============================================================================

readonly SCRIPT_DIR="$( dirname -- "$( readlink -f -- "$0" )" )"
readonly COMMANDS_DIR="${SCRIPT_DIR}/../main"
readonly LIB_DIR="${SCRIPT_DIR}/../lib"

readonly VERSION="1.0.0"

readonly REQUIRED_LIBS=(
  "Check.sh"
  "Utils.sh"
)

# ==============================================================================
# FUNCTIONS
# ==============================================================================

# Displays the current version of the tool.
# Arguments:
#   None
# Returns:
#   0 always
show_version() {
  echo "$(basename "$0") version ${VERSION}"
}

# Displays the main help message listing all available commands.
# Arguments:
#   None
# Returns:
#   0 always
show_main_help() {
  echo "Usage: $(basename "$0") <COMMAND> [options]"
  echo
  echo "Available commands:"
  echo "  Initialize                    - Gathers the input data and organizes the working directory."
  echo "  CaptainIdentification         - Performs identification and phylogenetic analysis of elements' captain."
  echo "  SyntenyClustering             - Performs clustering of elements based on collinear regions."
  echo "  ClusterCharacterization       - Analyzes and visualizes clusters with a captain phylogenetic tree."
  echo "  OrthogroupsOverrepresentation - Identifies orthogroups overrepresented in the dataset."
  echo "  OrthogroupsAnnotation         - Performs functional annotation of orthogroups."
  echo
  echo "Options:"
  echo "  -help     Show this help message"
  echo "  -version  Show version information"
  echo
  echo "Use '$(basename "$0") <COMMAND> -help' for help on a specific command."
}

# Verifies that the libraries directory and all required files exist.
# Arguments:
#   None
# Returns:
#   0 if all files are present, 1 if any file or directory is missing
check_libraries() {
  if [[ ! -d "$LIB_DIR" ]]; then
    echo "Error: folder '${LIB_DIR}' does not exist." >&2
    return 1
  fi

  for lib in "${REQUIRED_LIBS[@]}"; do
    if [[ ! -f "${LIB_DIR}/${lib}" ]]; then
      echo "Error: file '${LIB_DIR}/${lib}' does not exist." >&2
      return 1
    fi
  done
}

# Validates that the given command has an associated executable script.
# Arguments:
#   $1 - name of the command to validate
# Returns:
#   0 if the script exists and is executable, 1 otherwise
check_command() {
  local command="$1"
  local command_script="${COMMANDS_DIR}/${command}.sh"

  if [[ ! -x "$command_script" ]]; then
    echo "Error: unknown command '${command}'." >&2
    echo >&2
    show_main_help >&2
    return 1
  fi
}

# Parses arguments, validates the environment, and dispatches the command.
# Arguments:
#   $@ - original script arguments
# Returns:
#   0 on success, 1 on error
main() {
  local command="${1:-}"

  # Show help if no command was provided or explicitly requested
  if [[ -z "$command" || "$command" == "-help" ]]; then
    show_main_help
    exit 0
  fi

  # Show version if requested
  if [[ "$command" == "-version" ]]; then
    show_version
    exit 0
  fi

  shift

  check_libraries
  check_command "$command"

  exec "${COMMANDS_DIR}/${command}.sh" "$@"
}

main "$@"
